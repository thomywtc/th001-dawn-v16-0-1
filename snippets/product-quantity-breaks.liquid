{% comment %}
  Bloque Quantity Breaks basado en las configuraciones (settings) del schema
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign base_price = current_variant.price -%}

<style>
  .quantity-breaks-wrapper {
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quantity-breaks-title {
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .quantity-breaks-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .quantity-break-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    position: relative;
    user-select: none;
  }

  .quantity-break-card:hover {
    border-color: rgba(0, 0, 0, 0.4);
  }

  .quantity-break-card.is-active {
    border-width: 2px;
    border-color: var(--color-foreground, #000);
  }

  .quantity-break-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .quantity-break-radio {
    width: 18px;
    height: 18px;
    cursor: pointer;
    margin: 0;
  }

  .quantity-break-info {
    display: flex;
    flex-direction: column;
  }

  .quantity-break-label {
    font-weight: 700;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .quantity-break-prices {
    text-align: right;
    display: flex;
    flex-direction: column;
  }

  .quantity-break-final-price {
    font-weight: 700;
    font-size: 1.5rem;
  }

  .quantity-break-compare-price {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 1.2rem;
  }
</style>

<div class="quantity-breaks-wrapper color-{{ block.settings.color_scheme }}" data-block-id="{{ block.id }}">
  {%- if block.settings.heading != blank -%}
    <div class="quantity-breaks-title">{{ block.settings.heading }}</div>
  {%- endif -%}

  <div class="quantity-breaks-list" id="QuantityBreaksList-{{ block.id }}">
    
    {%- for i in (1..4) -%}
      {%- assign title_key = 'tier_' | append: i | append: '_title' -%}
      {%- assign qty_key = 'tier_' | append: i | append: '_qty' -%}
      {%- assign discount_key = 'tier_' | append: i | append: '_discount' -%}

      {%- assign tier_title = block.settings[title_key] -%}
      {%- assign tier_qty = block.settings[qty_key] -%}
      {%- assign tier_discount = block.settings[discount_key] -%}

      {%- if tier_title != blank and tier_qty > 0 -%}
        {%- comment %} Cálculo de precios en Liquid {% endcomment %}
        {%- assign total_units_price = base_price | times: tier_qty -%}
        
        {%- if tier_discount > 0 -%}
          {%- assign discount_multiplier = 100 | minus: tier_discount -%}
          {%- assign discounted_unit_price = base_price | times: discount_multiplier | divided_by: 100 -%}
          {%- assign final_total_price = discounted_unit_price | times: tier_qty -%}
        {%- else -%}
          {%- assign final_total_price = total_units_price -%}
        {%- endif -%}

        <div 
          class="quantity-break-card{% if forloop.first %} is-active{% endif %}" 
          data-qty="{{ tier_qty }}"
          data-discount="{{ tier_discount }}"
          data-tier-index="{{ i }}"
        >
          <div class="quantity-break-left">
            <input 
              type="radio" 
              name="quantity_break_option_{{ block.id }}" 
              class="quantity-break-radio"
              {% if forloop.first %}checked{% endif %}
            >
            <div class="quantity-break-info">
              <span class="quantity-break-label">
                {{ tier_title }}
                {%- if tier_discount > 0 -%}
                  <span class="quantity-break-badge">SAVE {{ tier_discount }}%</span>
                {%- endif -%}
              </span>
            </div>
          </div>

          <div class="quantity-break-prices">
            <span class="quantity-break-final-price" data-price-value="{{ final_total_price }}">
              {{ final_total_price | money }}
            </span>
            {%- if tier_discount > 0 -%}
              <span class="quantity-break-compare-price">
                {{ total_units_price | money }}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const blockContainer = document.querySelector('.quantity-breaks-list');
  if (!blockContainer) return;

  const cards = blockContainer.querySelectorAll('.quantity-break-card');
  const priceWrapper = document.querySelector('.price');

  // 1. GUARDAR PRECIOS INICIALES DEL TEMA AL CARGAR LA PÁGINA
  const initialRegularPrice = document.querySelector('.price .price__regular .price-item--regular')?.innerText;
  const initialSalePrice = document.querySelector('.price .price__sale .price-item--sale')?.innerText;
  const initialComparePrice = document.querySelector('.price s.price-item--regular')?.innerText;
  const initialIsOnSale = priceWrapper ? priceWrapper.classList.contains('price--on-sale') : false;

  cards.forEach(card => {
    card.addEventListener('click', function () {
      // 2. Activar tarjeta seleccionada
      cards.forEach(c => c.classList.remove('is-active'));
      this.classList.add('is-active');

      const selectedQty = parseInt(this.dataset.qty, 10);
      const discount = parseFloat(this.dataset.discount || 0);

      const finalPriceText = this.querySelector('.quantity-break-final-price')?.innerText;
      const comparePriceText = this.querySelector('.quantity-break-compare-price')?.innerText;

      // 3. Actualizar input de cantidad en el formulario de Shopify
      document.querySelectorAll('input[name="quantity"]').forEach(input => {
        input.value = selectedQty;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });

      // 4. Elementos del DOM del bloque de precio principal
      const regularPriceEl = document.querySelector('.price .price__regular .price-item--regular');
      const salePriceEl = document.querySelector('.price .price__sale .price-item--sale');
      let comparePriceEl = document.querySelector('.price s.price-item--regular');

      // 5. LÓGICA DE RESTAURACIÓN Y ACTUALIZACIÓN

      if (selectedQty === 1 && discount === 0) {
        // --- OPCIÓN SINGLE (Restaurar estado inicial del producto) ---
        if (priceWrapper) {
          if (initialIsOnSale) {
            priceWrapper.classList.add('price--on-sale');
          } else {
            priceWrapper.classList.remove('price--on-sale');
          }
        }

        if (regularPriceEl && initialRegularPrice) regularPriceEl.innerText = initialRegularPrice;
        if (salePriceEl && initialSalePrice) salePriceEl.innerText = initialSalePrice;

        if (comparePriceEl) {
          if (initialIsOnSale && initialComparePrice) {
            comparePriceEl.innerText = initialComparePrice;
            comparePriceEl.style.display = 'inline';
          } else {
            comparePriceEl.style.display = 'none';
          }
        }

      } else {
        // --- OPCIONES MULTI-PACK (2-Pack, 3-Pack, etc.) ---

        // Forzar siempre la clase de oferta
        if (priceWrapper) priceWrapper.classList.add('price--on-sale');

        // Actualizar precio de venta final
        if (salePriceEl) salePriceEl.innerText = finalPriceText;

        // Crear elemento <s> si el producto no tenía precio de comparación de origen
        if (!comparePriceEl && priceWrapper) {
          const saleContainer = document.querySelector('.price .price__sale');
          if (saleContainer) {
            const sTag = document.createElement('s');
            sTag.className = 'price-item price-item--regular';
            saleContainer.insertBefore(sTag, saleContainer.firstChild);
            comparePriceEl = sTag;
          }
        }

        // Asignar el precio tachado calculado para el paquete
        if (comparePriceEl) {
          comparePriceEl.innerText = comparePriceText;
          comparePriceEl.style.display = 'inline';
        }
      }
    });
  });
});
</script>