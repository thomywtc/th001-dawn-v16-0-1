{% comment %}
  Quantity breaks.

  Prices are computed from this block's own tier settings (tier_N_qty / tier_N_discount). It does
  not read Shopify's quantity price breaks, so it is an informative display: whatever discount ends
  up being charged is the store's automatic discounts.

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - section_id: {String} id of the section rendering the block.
  - product_form_id: {String} id of the product form.

  Usage:
  {% render 'product-quantity-breaks', product: product, block: block, section_id: section.id, product_form_id: product_form_id %}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign base_price = current_variant.price

  assign tiers_configured = 0

  for i in (1..4)
    assign cfg_title_key = 'tier_' | append: i | append: '_title'
    assign cfg_qty_key = 'tier_' | append: i | append: '_qty'

    if block.settings[cfg_title_key] != blank and block.settings[cfg_qty_key] > 0
      assign tiers_configured = tiers_configured | plus: 1
    endif
  endfor
-%}

{%- if product != blank and tiers_configured > 0 -%}
  <style>
    .tier_badge{
        position: absolute;
        top: -9px;
        left: 50%;
        font-size: 11px;
        transform: translateX(-50%);
        border-radius: 50px;
        padding: 0 12px;
        color: #fff;
        &.badge_1{
            background:#dc2626;
        }
        &.badge_2{
            background:#746053;
        }
        &.badge_3{
            background:#97b917;
        }
    }
    .quantity-breaks-wrapper {
      margin: 1.5rem 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .quantity-breaks-title {
      font-size: 1.6rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .quantity-breaks-list {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .quantity-break-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 10px;
      border: 1px solid rgba(var(--color-foreground), 0.15);
      border-radius: 8px;
      cursor: pointer;
      transition:
        border-color 0.2s ease-in-out,
        border-width 0.2s ease-in-out;
      position: relative;
      user-select: none;
    }

    .quantity-break-card:hover {
      border-color: rgba(var(--color-foreground), 0.4);
    }

    /* No hardcoded border colour here: the active card carries the block's active
       colour scheme, so its foreground token resolves the border. */
    .quantity-break-card.is-active {
      border-width: 2px;
      border-color: rgba(var(--color-foreground), 0.9);
    }

    /* Keyboard focus only, so clicking a card does not light up an outline. If :has() is
       unsupported the rule is dropped and focus just falls back to the browser default. */
    .quantity-break-card:has(.quantity-break-radio:focus-visible) {
      outline: 2px solid rgba(var(--color-foreground), 0.6);
      outline-offset: 2px;
    }

    .quantity-break-left {
      display: flex;
      align-items: center;
      gap: 1.2rem;
    }

    .quantity-break-radio {
      position:absolute;
      width: 0;
      height: 0;
      cursor: pointer;
      margin: 0;
      flex-shrink: 0;
    }

    .quantity-break-info {
      display: flex;
      flex-direction: column;
    }

    .quantity-break-label {
      font-weight: 700;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      letter-spacing: 0;
    }

    .quantity-break-badge {
      display: inline-block;
      padding: 0.1rem 0.5rem;
      border-radius: 999px;
      background-color: rgba(var(--color-foreground), 0.1);
      color: rgba(var(--color-foreground), 0.9);
      font-size: 1.1rem;
      font-weight: 600;
      line-height: 1.6;
      white-space: nowrap;
    }

    .quantity-break-prices {
      text-align: right;
      display: flex;
      flex-direction: column;
    }

    .quantity-break-final-price {
      font-weight: 500;
      font-size: 14px;
      letter-spacing: 0;
    }

    .quantity-break-compare-price {
      text-decoration: line-through;
      opacity: 0.6;
      font-size: 1.2rem;
    }
    .qty-left-wrapper{
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
    }
    .qty-right-wrapper{
      display: flex;
      height: 100%;
      align-items: flex-end;
      padding-top: 10px;
    }
    .quantity-break-prices-withdisc{
      border-radius: 50px;
      font-size: 12px;
      padding: 1px 10px;
      background: rgba(var(--color-foreground), 1);
      color: rgb(var(--color-background));
    }
  </style>

  <quantity-breaks
    class="quantity-breaks-wrapper"
    data-block-id="{{ block.id }}"
    data-section-id="{{ section_id }}"
    data-product-form-id="{{ product_form_id }}"
    data-color-base="color-{{ block.settings.color_scheme }}"
    data-color-active="color-{{ block.settings.color_scheme_active }}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <div class="quantity-breaks-title">{{ block.settings.heading }}</div>
    {%- endif -%}

    <div class="quantity-breaks-list" role="radiogroup">
      {%- for i in (1..4) -%}
        {%- liquid
          assign title_key = 'tier_' | append: i | append: '_title'
          assign qty_key = 'tier_' | append: i | append: '_qty'
          assign discount_key = 'tier_' | append: i | append: '_discount'
          assign badge_key = 'tier_' | append: i | append: '_badge'
          assign image_key = 'tier_' | append: i | append: '_image'

          assign tier_title = block.settings[title_key]
          assign tier_qty = block.settings[qty_key]
          assign tier_discount = block.settings[discount_key]
          assign tier_badge = block.settings[badge_key]
          assign tier_image = block.settings[image_key]
        -%}

        {%- if tier_title != blank and tier_qty > 0 -%}
          {%- liquid
            assign compare_cents = base_price | times: tier_qty

            if tier_discount > 0
              assign discount_multiplier = 100 | minus: tier_discount
              assign unit_cents = base_price | times: discount_multiplier | divided_by: 100 | round
              assign total_cents = unit_cents | times: tier_qty
            else
              assign total_cents = compare_cents
            endif
          -%}

          <label
            class="quantity-break-card color-{{ block.settings.color_scheme }}{% if forloop.first %} is-active color-{{ block.settings.color_scheme_active }}{% endif %}"
            data-qb-card
            data-tier-index="{{ i }}"
            data-qty="{{ tier_qty }}"
            data-discount="{{ tier_discount }}"
          >
            <div class="tier_badge badge_{{ i }}">{{ tier_badge }}</div>
            <div class="qty-left-wrapper">
              <span class="quantity-break-left">
                <input
                  type="radio"
                  name="quantity_break_option_{{ block.id }}"
                  class="quantity-break-radio"
                  data-qb-radio
                  value="{{ tier_qty }}"
                  {% if forloop.first %}checked{% endif %}
                >
                <span class="quantity-break-info">
                  <span class="quantity-break-label">
                    {{ tier_title }}
                    {%- if tier_discount > 0 -%}
                      <span class="quantity-break-badge hidden">SAVE {{ tier_discount }}%</span>
                    {%- endif -%}
                  </span>
                </span>
              </span>

              <span class="quantity-break-prices">
                <span class="quantity-break-final-price" data-qb-total>{{ total_cents | money }}</span>
                {%- if tier_discount > 0 -%}
                  <span class="quantity-break-compare-price hidden" data-qb-compare>{{ compare_cents | money }}</span>
                {%- endif -%}
              </span>
              <span class="quantity-break-prices-withdisc">
                {{ base_price | money }}
              </span>
            </div>
            <div class="qty-right-wrapper">
              {%- if tier_image != blank -%}
              <img src="{{ tier_image | image_url: height:80  }}"/>
              {%- endif -%}
            </div>
          </label>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </quantity-breaks>
{%- endif -%}

<script>
  if (!customElements.get('quantity-breaks')) {
    customElements.define(
      'quantity-breaks',
      class QuantityBreaks extends HTMLElement {
        variantChangeUnsubscriber = undefined;
        quantityInputTimer = undefined;
        activeQty = 1;
        activeDiscount = 0;
        pristineHtml = undefined;
        pristineIsOnSale = false;
        boundQuantityInput = undefined;
        onQuantityInput = () => {
          clearTimeout(this.quantityInputTimer);
          this.quantityInputTimer = setTimeout(() => this.selectByQuantity(), 250);
        };

        connectedCallback() {
          // Re-binding a moved node would duplicate every listener.
          if (this.dataset.qbBound === 'true') return;
          this.dataset.qbBound = 'true';

          this.onCardChange = (event) => {
            if (!event.target.matches('[data-qb-radio]')) return;
            this.selectCard(event.target.closest('[data-qb-card]'));
          };
          this.addEventListener('change', this.onCardChange);

          // `onQuantityInput` is a class field so it already exists here: `resolveTargets` binds
          // it, and binding before the handler exists would leave the input permanently deaf.
          this.resolveTargets();
          this.rememberPristinePrice();

          this.applyActive();

          // `subscribe` only exists once the deferred theme scripts have run.
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => this.init(), { once: true });
          } else {
            this.init();
          }
        }

        disconnectedCallback() {
          this.variantChangeUnsubscriber?.();
          clearTimeout(this.quantityInputTimer);
          this.boundQuantityInput?.removeEventListener('input', this.onQuantityInput);
        }

        get cards() {
          return this.querySelectorAll('[data-qb-card]');
        }

        init() {
          this.variantChangeUnsubscriber = subscribe(PUB_SUB_EVENTS.variantChange, (event) => {
            const { sectionId, html } = event.data ?? {};
            if (sectionId !== this.dataset.sectionId || !html) return;

            // Dawn already re-rendered the price block (product-info.js) before publishing this
            // event, so the live DOM is the pristine markup for the incoming variant.
            this.resolveTargets();
            this.rememberPristinePrice();

            // The payload is the section already re-rendered by Liquid for that variant, so the
            // block's own markup is the source of truth for the new prices. Copying those strings
            // keeps Liquid as the only place that does money formatting or discount arithmetic.
            this.adoptPricesFrom(html);
            this.applyActive();
          });
        }

        resolveTargets() {
          this.quantityInput = this.findQuantityInput();
          this.bindQuantityInput();
        }

        /**
         * Dawn swaps the quantity input when it re-renders the quantity rules, and the input may
         * also appear after this block if the merchant dragged quantity-breaks above
         * quantity_selector. Re-binding on every resolve covers both, and the identity check keeps
         * a single listener when the node is unchanged.
         */
        bindQuantityInput() {
          if (this.quantityInput === this.boundQuantityInput) return;
          this.boundQuantityInput?.removeEventListener('input', this.onQuantityInput);
          this.boundQuantityInput = this.quantityInput ?? undefined;
          this.boundQuantityInput?.addEventListener('input', this.onQuantityInput);
        }

        /**
         * The product quantity input is emitted by the quantity_selector block and is attached to
         * the form with a `form` attribute, so it does not have to sit inside the form element.
         * The id lookup is the fast path; the fallbacks cover the input being rendered after this
         * block (the merchant can drag quantity-breaks above quantity_selector in the editor) and
         * Dawn replacing the node when it re-renders the quantity rules.
         */
        findQuantityInput() {
          const byId = document.getElementById(`Quantity-${this.dataset.sectionId}`);
          if (byId) return byId;

          const formId = this.dataset.productFormId;
          if (formId) {
            const byForm = document.querySelector(`input[name="quantity"][form="${formId}"]`);
            if (byForm) return byForm;
          }

          return (
            this.closest('product-info')?.querySelector('.quantity__input') ??
            document.querySelector('.product-form__quantity .quantity__input')
          );
        }

        /**
         * Dawn renders the price as its own section block, so a merchant can drag it below this
         * one. Resolving on every use instead of caching at connect time keeps the block working
         * in either order; at connectedCallback the price block may simply not be parsed yet.
         */
        get priceEl() {
          return document.getElementById(`price-${this.dataset.sectionId}`)?.querySelector('.price') ?? null;
        }

        /**
         * Overwrites the snapshot, including clearing it when the price block is gone, so a stale
         * snapshot from the previous variant can never be used as a restore target.
         */
        rememberPristinePrice() {
          const priceEl = this.priceEl;
          if (!priceEl) {
            this.pristineHtml = undefined;
            this.pristineIsOnSale = false;
            return;
          }
          this.pristineHtml = priceEl.innerHTML;
          this.pristineIsOnSale = priceEl.classList.contains('price--on-sale');
        }

        /**
         * Taken on the first interaction rather than at connect time, because the price block may
         * have rendered after this one. It has to happen before the first paint, and only once
         * per variant, or the snapshot would capture this block's own markup.
         */
        ensurePristinePrice() {
          if (this.pristineHtml === undefined) this.rememberPristinePrice();
        }

        /**
         * Copies the rendered tier prices out of a freshly rendered section fragment, matching
         * cards by the tier index so they survive any change in how many tiers are configured.
         */
        adoptPricesFrom(html) {
          const fragment = html.querySelector(`[data-block-id="${this.dataset.blockId}"]`);
          if (!fragment) return;

          this.cards.forEach((card) => {
            const source = fragment.querySelector(
              `[data-qb-card][data-tier-index="${card.dataset.tierIndex}"]`,
            );
            if (!source) return;

            this.copyText(source, card, '[data-qb-total]', '[data-qb-total]');
            this.copyText(source, card, '[data-qb-compare]', '[data-qb-compare]');
          });
        }

        copyText(source, target, sourceSelector, targetSelector) {
          const from = source.querySelector(sourceSelector);
          const to = target.querySelector(targetSelector);
          if (!from || !to) return;
          to.textContent = from.textContent.trim();
        }

        selectCard(card) {
          if (!card) return;

          this.ensurePristinePrice();

          this.cards.forEach((other) => {
            const isActive = other === card;
            other.classList.toggle('is-active', isActive);
            this.applyActiveColor(other, isActive);
          });

          this.activeQty = parseInt(card.dataset.qty, 10) || 1;
          this.activeDiscount = parseInt(card.dataset.discount, 10) || 0;
          this.writeQuantity();
          this.paintPrice();
        }

        /**
         * Keeps the block in sync when the quantity is typed directly. A quantity that matches no
         * tier keeps no card selected and falls back to the undiscounted price, which is the
         * honest thing to show rather than leaving a pack's price on screen.
         */
        selectByQuantity() {
          const value = parseInt(this.quantityInput?.value, 10);
          if (!Number.isFinite(value)) return;

          this.ensurePristinePrice();

          const match = Array.from(this.cards).find(
            (card) => parseInt(card.dataset.qty, 10) === value,
          );

          this.cards.forEach((card) => {
            const isActive = card === match;
            card.classList.toggle('is-active', isActive);
            this.applyActiveColor(card, isActive);
          });

          this.activeQty = value;
          this.activeDiscount = match ? parseInt(match.dataset.discount, 10) || 0 : 0;
          this.paintPrice();
        }

        applyActiveColor(card, isActive) {
          const base = this.dataset.colorBase;
          const active = this.dataset.colorActive;
          // The active card re-declares the colour scheme on the child element, so Dawn's
          // custom properties override the wrapper by inheritance instead of by rule order.
          if (!base || !active || base === active) return;

          card.classList.remove(base, active);
          card.classList.add(isActive ? active : base);
        }

        applyActive() {
          const checked = this.querySelector('[data-qb-radio]:checked');
          if (checked) {
            this.selectCard(checked.closest('[data-qb-card]'));
            return;
          }
          this.selectByQuantity();
        }

        writeQuantity() {
          // Dawn replaces the input when it re-renders the quantity rules, so a node that has
          // been detached is resolved again rather than written to.
          if (!this.quantityInput?.isConnected) this.resolveTargets();

          const input = this.quantityInput;
          if (!input) {
            // Previously this failed silently, which made the block look broken for no visible
            // reason. The id the block looked for is part of the message so it can be matched up
            // against the rendered markup.
            console.warn(
              'quantity-breaks: no se encontro el input de cantidad. Se busco el id "Quantity-' +
                this.dataset.sectionId +
                '" y el form "' +
                this.dataset.productFormId +
                '".',
            );
            return;
          }

          const min = parseInt(input.dataset.min || input.min, 10);
          const max = parseInt(input.dataset.max || input.max, 10);

          // Only clamped to the variant's own rules. The tier quantity is not snapped to the
          // increment: a pack of 2 is still 2 units even if the variant sells in steps of 3, and
          // number inputs submit their value regardless of step.
          let next = this.activeQty;
          if (Number.isFinite(min)) next = Math.max(next, min);
          if (Number.isFinite(max)) next = Math.min(next, max);
          if (Number.isFinite(min) && Number.isFinite(max) && next < min) next = min;
          if (String(next) === input.value) return;

          input.value = next;
          // Dawn listens for both; `QuantityInput` and `validateQtyRules` need the change event.
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));

          if (String(next) !== input.value) {
            console.warn(
              `quantity-breaks: se intento escribir ${next} en el input de cantidad pero quedo ` +
                `"${input.value}". Otro script esta sobreescribiendolo.`,
            );
          }
        }

        paintPrice() {
          const priceEl = this.priceEl;
          if (!priceEl) {
            console.warn(
              `quantity-breaks: no se encontro el bloque de precio. Se busco el id "price-${
                this.dataset.sectionId
              }". Revisa el orden de los bloques en el editor del tema.`,
            );
            return;
          }

          if (this.activeDiscount === 0) {
            // Base tier: hand the block back exactly what Dawn rendered for this variant.
            if (this.pristineHtml !== undefined) priceEl.innerHTML = this.pristineHtml;
            priceEl.classList.toggle('price--on-sale', this.pristineIsOnSale);
            return;
          }

          // price.liquid uses volume-pricing--sale-badge instead of price--on-sale when the
          // product has native quantity breaks, so leave that markup to Dawn's own volume pricing.
          if (priceEl.classList.contains('volume-pricing--sale-badge')) return;
          if (priceEl.classList.contains('price--sold-out')) return;

          const card = this.querySelector('[data-qb-card].is-active');
          if (!card) return;

          // price.liquid always renders an <s class="price-item price-item--regular"> inside
          // .price__sale, so only its text changes here. Targeting it through .price__sale avoids
          // the identical element price.liquid also renders in .price__regular.
          const compareEl = priceEl.querySelector('.price__sale s.price-item--regular');
          const saleEl = priceEl.querySelector('.price__sale .price-item--sale');

          const total = card.querySelector('[data-qb-total]')?.textContent.trim();
          const compare = card.querySelector('[data-qb-compare]')?.textContent.trim();

          if (saleEl && total) saleEl.textContent = total;
          if (compareEl && compare) compareEl.textContent = compare;

          // component-price.css only reveals .price__sale and strikes the compare price when
          // price--on-sale is present, so this single class drives the whole look.
          priceEl.classList.add('price--on-sale');
        }
      },
    );
  }
</script>
