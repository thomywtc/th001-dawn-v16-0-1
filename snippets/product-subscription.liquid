{% comment %}
  Snippet: product-subscription.liquid
  Renders the Shopify selling plans (one-time purchase / subscribe & save) for the current variant.

  Accepts:
  - product: {Object} Product object.
  - block: {Object} The 'subscription' block, used for its settings (optional).
  - product_form_id: {String} Id of the product form the `selling_plan` input must be bound to.

  Usage:
  {% render 'product-subscription', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}

{%- if product.selling_plan_groups.size > 0 -%}
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign use_currency = settings.currency_code_enabled

    if product_form_id == blank
      assign subscription_form_id = 'product-form-' | append: section.id
    else
      assign subscription_form_id = product_form_id
    endif

    # Fall back to valid handles: blocks saved before the settings existed return nil
    assign inactive_scheme = block.settings.color_scheme | default: section.settings.color_scheme
    assign active_scheme = block.settings.color_scheme_active | default: settings.color_schemes[1].id | default: section.settings.color_scheme

    assign one_time_label = block.settings.one_time_purchase_label | default: 'One-time purchase'
    assign subscribe_label = block.settings.subscribe_and_save_label | default: 'Subscribe & save'
    assign frequency_label = block.settings.frequency_label

    assign first_group = product.selling_plan_groups[0]
    assign first_plan = first_group.selling_plans[0]

    # `where:` cannot be used here: it compares the selling plan objects instead of their
    # ids, so it silently returns nothing. The allocation is matched by id instead.
    assign first_allocation = blank
    for allocation in current_variant.selling_plan_allocations
      if allocation.selling_plan.id == first_plan.id
        assign first_allocation = allocation
        break
      endif
    endfor

    assign first_discount = 0
    if first_allocation and current_variant.price > first_allocation.price
      assign first_discount = current_variant.price | minus: first_allocation.price | times: 100.0 | divided_by: current_variant.price | round
    endif
  -%}

  <product-subscription
    class="product-subscription"
    data-subscription-block
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-form-id="{{ subscription_form_id }}"
    data-price-target="price-{{ section.id }}"
    data-current-variant="{{ current_variant.id }}"
    data-label-regular="{{ 'products.product.price.regular_price' | t | escape }}"
    data-label-sale="{{ 'products.product.price.sale_price' | t | escape }}"
    data-use-currency="{{ use_currency }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-money-with-currency-format="{{ shop.money_with_currency_format | escape }}"
  >
    {%- comment -%} Prices and selling plan allocations of every variant {%- endcomment -%}
    <script type="application/json" data-subscription-json>
      {
        "variants": {
          {%- for variant in product.variants -%}
            "{{ variant.id }}": {
              "price": {{ variant.price }},
              "available": {% if variant.available %}true{% else %}false{% endif %},
              "formatted_price": {% if use_currency %}{{ variant.price | money_with_currency | json }}{% else %}{{ variant.price | money | json }}{% endif %},
              "allocations": {
                {%- for allocation in variant.selling_plan_allocations -%}
                  {%- liquid
                    assign allocation_discount = 0
                    if variant.price > allocation.price
                      assign allocation_discount = variant.price | minus: allocation.price | times: 100.0 | divided_by: variant.price | round
                    endif
                  -%}
                  "{{ allocation.selling_plan.id }}": {
                    "price": {{ allocation.price }},
                    "available": {% if allocation.available == false %}false{% else %}true{% endif %},
                    "discount_percent": {{ allocation_discount }},
                    "per_delivery_price_cents": {{ allocation.per_delivery_price }},
                    "formatted_price": {% if use_currency %}{{ allocation.price | money_with_currency | json }}{% else %}{{ allocation.price | money | json }}{% endif %},
                    "formatted_per_delivery_price": {% if use_currency %}{{ allocation.per_delivery_price | money_with_currency | json }}{% else %}{{ allocation.per_delivery_price | money | json }}{% endif %}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        }
      }
    </script>

    <fieldset class="product-subscription__options">
      <legend class="visually-hidden">{{ 'products.product.subscription.label' | t }}</legend>

      {%- comment -%} One-time purchase {%- endcomment -%}
      <div
        class="product-subscription__option is-active color-{{ inactive_scheme }}"
        data-option-type="one-time"
        data-scheme-inactive="color-{{ inactive_scheme }}"
        data-scheme-active="color-{{ active_scheme }}"
      >
        <label class="product-subscription__label" for="SubscriptionOneTime-{{ section.id }}">
          <input
            class="visually-hidden"
            type="radio"
            id="SubscriptionOneTime-{{ section.id }}"
            name="purchase_option_{{ product.id }}"
            value="one-time"
            checked
            data-subscription-radio
          >
          <span class="product-subscription__radio-dot" aria-hidden="true"></span>
          <span class="product-subscription__title">{{ one_time_label }}</span>
          <span class="product-subscription__price" data-one-time-price>
            {%- if use_currency -%}
              {{ current_variant.price | money_with_currency }}
            {%- else -%}
              {{ current_variant.price | money }}
            {%- endif -%}
          </span>
        </label>
      </div>

      {%- comment -%} Subscribe & save {%- endcomment -%}
      <div
        class="product-subscription__option color-{{ inactive_scheme }}"
        data-option-type="subscription"
        data-scheme-inactive="color-{{ inactive_scheme }}"
        data-scheme-active="color-{{ active_scheme }}"
      >
        <label class="product-subscription__label" for="SubscriptionPlan-{{ section.id }}">
          <input
            class="visually-hidden"
            type="radio"
            id="SubscriptionPlan-{{ section.id }}"
            name="purchase_option_{{ product.id }}"
            value="subscription"
            data-subscription-radio
          >
          <span class="product-subscription__radio-dot" aria-hidden="true"></span>
          <span class="product-subscription__title">{{ subscribe_label }}</span>
          <span
            class="product-subscription__badge badge price__badge-sale color-{{ settings.sale_badge_color_scheme }}"
            data-subscription-badge
            data-template="{{ 'products.product.subscription.save_percent' | t: percent: '[percent]' | escape }}"
            {% if first_discount <= 0 %}hidden{% endif %}
          >
            {%- if first_discount > 0 -%}
              {{- 'products.product.subscription.save_percent' | t: percent: first_discount -}}
            {%- endif -%}
          </span>
          <span class="product-subscription__price" data-subscription-price>
            {%- if first_allocation -%}
              {%- if use_currency -%}
                {{ first_allocation.price | money_with_currency }}
              {%- else -%}
                {{ first_allocation.price | money }}
              {%- endif -%}
            {%- elsif use_currency -%}
              {{ current_variant.price | money_with_currency }}
            {%- else -%}
              {{ current_variant.price | money }}
            {%- endif -%}
          </span>
        </label>

        <p
          class="product-subscription__note hidden"
          data-per-delivery-price
          data-template="{{ 'products.product.subscription.per_delivery' | t: price: '[price]' | escape }}"
          {% unless first_allocation.per_delivery_price %}hidden{% endunless %}
        >
          {%- if first_allocation.per_delivery_price -%}
            {%- comment -%}
              `per_delivery_price` comes back in cents, so it has to be formatted before the
              translation interpolates it: passed raw it read "18000 per delivery".
            {%- endcomment -%}
            {%- if use_currency -%}
              {%- assign first_per_delivery = first_allocation.per_delivery_price | money_with_currency -%}
            {%- else -%}
              {%- assign first_per_delivery = first_allocation.per_delivery_price | money -%}
            {%- endif -%}
            {{-
              'products.product.subscription.per_delivery'
              | t: price: first_per_delivery
            -}}
          {%- endif -%}
        </p>

        <div class="product-subscription__details">
          {%- comment -%}
            The selling plan names already read "Deliver every month", so the caption is
            optional and off by default. Leave the option text untouched.
          {%- endcomment -%}
          {%- if frequency_label != blank -%}
            <label class="product-subscription__delivery" for="SubscriptionFrequency-{{ section.id }}">
              {{ frequency_label }}
            </label>
          {%- endif -%}
          <select
            class="product-subscription__select"
            id="SubscriptionFrequency-{{ section.id }}"
            aria-label="{{ 'products.product.subscription.frequency' | t | escape }}"
            data-selling-plan-select
          >
            {%- for group in product.selling_plan_groups -%}
              {%- for plan in group.selling_plans -%}
                {%- liquid
                  assign plan_allocation = blank
                  for allocation in current_variant.selling_plan_allocations
                    if allocation.selling_plan.id == plan.id
                      assign plan_allocation = allocation
                      break
                    endif
                  endfor
                -%}
                <option
                  value="{{ plan.id }}"
                  {% if plan_allocation == blank or plan_allocation.available == false %}
                    disabled
                  {% endif %}
                >
                  {{- plan.name -}}
                </option>
              {%- endfor -%}
            {%- endfor -%}
          </select>
        </div>
      </div>
    </fieldset>

    {%- comment -%}
      Bound to the product form through the `form` attribute so it travels in the FormData
      built by product-form.js. An empty value means one-time purchase.
    {%- endcomment -%}
    <input
      type="hidden"
      name="selling_plan"
      value=""
      form="{{ subscription_form_id }}"
      data-selling-plan-input
    >

    <style>
      .product-subscription {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        margin: 1.6rem 0;
      }

      .product-subscription__options {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
        border: 0;
      }

      .product-subscription__option {
        position: relative;
        display: block;
        border: var(--inputs-border-width) solid rgba(var(--color-foreground), var(--inputs-border-opacity));
        border-radius: var(--inputs-radius);
        padding: 1.4rem 1.6rem;
        background: var(--gradient-background);
        transition: box-shadow 0.2s ease-in-out, opacity 0.2s ease-in-out;
      }

      .product-subscription__option.is-active {
        box-shadow: 0 0 0 0.1rem rgba(var(--color-foreground), 0.5);
      }

      .product-subscription__option.is-disabled {
        opacity: 0.5;
      }

      .product-subscription__option.is-disabled .product-subscription__label {
        cursor: not-allowed;
      }

      .product-subscription__label {
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
      }

      .product-subscription__radio:focus-visible + .product-subscription__radio-dot {
        outline: 0.2rem solid rgba(var(--color-foreground), 0.5);
        outline-offset: 0.2rem;
      }

      .product-subscription__radio-dot {
        flex: 0 0 auto;
        width: 1.8rem;
        height: 1.8rem;
        border: var(--inputs-border-width) solid rgba(var(--color-foreground), var(--inputs-border-opacity));
        border-radius: 50%;
        transition: border-color 0.2s ease-in-out, border-width 0.2s ease-in-out;
      }

      .product-subscription__option.is-active .product-subscription__radio-dot {
        border-width: 0.5rem;
        border-color: rgb(var(--color-foreground));
      }

      .product-subscription__title {
        flex: 1 1 auto;
        color: rgb(var(--color-foreground));
        font-weight: var(--font-body-weight-bold);
      }

      .product-subscription__badge {
        font-size: 1.1rem;
        line-height: 1.4;
      }

      .product-subscription__price {
        flex: 0 0 auto;
        color: rgb(var(--color-foreground));
        font-weight: var(--font-body-weight-bold);
      }

      .product-subscription__note {
        margin: 0.6rem 0 0 2.8rem;
        color: rgba(var(--color-foreground), 0.75);
      }

      .product-subscription__details {
        display: none;
        align-items: center;
        gap: 1rem;
        margin-top: 1.2rem;
        padding-left: 2.8rem;
      }

      .product-subscription__option.is-active .product-subscription__details {
        display: flex;
      }

      .product-subscription__delivery {
        color: rgb(var(--color-foreground));
      }

      .product-subscription__select {
        max-width: 100%;
        padding: 0.6rem 3rem 0.6rem 1.2rem;
        border: var(--inputs-border-width) solid rgba(var(--color-foreground), var(--inputs-border-opacity));
        border-radius: var(--inputs-radius);
        background-color: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
        font-size: 1.4rem;
        cursor: pointer;
      }
    </style>

    <script>
  if (!customElements.get('product-subscription')) {
    customElements.define(
      'product-subscription',
      class ProductSubscription extends HTMLElement {
        variantChangeUnsubscriber = undefined;
        variantIdInputListener = undefined;

        connectedCallback() {
          // ESTADO INTERNO PARA INTEGRACIÓN CON QUANTITY BREAKS / PACKS
          this.currentQty = 1;
          this.overridePriceCents = null;
          this.currentFormattedPrice = null;
          this.currentFormattedCompare = null;

          this.addEventListener('change', (event) => {
            if (event.target.matches('[data-subscription-radio], [data-selling-plan-select]')) {
              this.update();
            }
          });

          this.json = this.parseJson('[data-subscription-json]');
          if (!this.json) return;

          this.priceContainer = this.getPriceContainer();
          this.oneTimePrice = this.querySelector('[data-one-time-price]');
          this.subPrice = this.querySelector('[data-subscription-price]');
          this.badge = this.querySelector('[data-subscription-badge]');
          this.perDeliveryPrice = this.querySelector('[data-per-delivery-price]');
          this.planSelect = this.querySelector('[data-selling-plan-select]');
          this.hiddenInput = this.querySelector('[data-selling-plan-input]');
          this.oneTimeOption = this.querySelector('[data-option-type="one-time"]');
          this.subOption = this.querySelector('[data-option-type="subscription"]');
          this.subRadio = this.subOption.querySelector('[data-subscription-radio]');
          this.variantId = this.dataset.currentVariant;

          // ESCUCHA EVENTOS DISPARADOS POR EL BLOQUE DE QUANTITY BREAKS
          // Nombrado para poder quitarlo en disconnectedCallback: el editor del tema vuelve a
          // renderizar la sección y, sin esto, cada paso por el DOM dejaba un listener de más.
          this.onQuantityBreakChange = (e) => {
            if (!e.detail) return;

            this.currentQty = e.detail.quantity || 1;
            this.overridePriceCents = e.detail.packPriceCents ?? null;
            this.currentFormattedPrice = e.detail.formattedPrice || null;
            this.currentFormattedCompare = e.detail.formattedCompare || null;
            this.update();
          };
          document.addEventListener('quantity-break:change', this.onQuantityBreakChange);

          this.variantIdInputListener = (event) => {
            if (event.target?.name !== 'id') return;

            const nextVariantId = event.target.value;
            if (!this.json.variants[nextVariantId] || nextVariantId === this.variantId) return;

            this.variantId = nextVariantId;
            this.overridePriceCents = null;
            this.currentFormattedPrice = null;
            this.currentFormattedCompare = null;
            setTimeout(() => this.refresh(), 0);
          };
          document.addEventListener('change', this.variantIdInputListener);

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => this.init(), { once: true });
          } else {
            this.init();
          }
        }

        disconnectedCallback() {
          this.variantChangeUnsubscriber?.();
          document.removeEventListener('change', this.variantIdInputListener);
          document.removeEventListener('quantity-break:change', this.onQuantityBreakChange);
        }

        init() {
          if (!this.isConnected) return;

          this.variantChangeUnsubscriber = subscribe(PUB_SUB_EVENTS.variantChange, (event) => {
            const nextVariantId = event?.data?.variant?.id;
            if (!this.isConnected || !nextVariantId || !this.json.variants[nextVariantId]) return;

            this.variantId = String(nextVariantId);
            // El total del pack pertenece a la variante anterior: se descarta y se vuelve a
            // calcular desde el precio de la nueva, que es lo único válido en este punto.
            this.overridePriceCents = null;
            this.currentFormattedPrice = null;
            this.currentFormattedCompare = null;
            this.refresh();
          });

          this.refresh();
        }

        refresh() {
          if (!this.isConnected) return;

          this.updatePlanAvailability();
          this.rememberPrice();
          this.update();
        }

        parseJson(selector) {
          try {
            return JSON.parse(this.querySelector(selector)?.textContent);
          } catch {
            return null;
          }
        }

        getPriceContainer() {
          return document.getElementById(this.dataset.priceTarget);
        }

        getVariant() {
          const formVariantId = document
            .getElementById(this.dataset.formId)
            ?.querySelector('input[name="id"]')?.value;

          return this.json.variants[this.variantId] || this.json.variants[formVariantId];
        }

        getSelectedAllocation() {
          const allocation = this.getVariant()?.allocations?.[this.planSelect.value];
          return allocation?.available === false ? null : allocation;
        }

        updatePlanAvailability() {
          const allocations = this.getVariant()?.allocations || {};
          const options = [...this.planSelect.querySelectorAll('option')];

          options.forEach((option) => {
            const allocation = allocations[option.value];
            option.disabled = !allocation || allocation.available === false;
          });

          const hasPlans = options.some((option) => !option.disabled);

          this.subOption.classList.toggle('is-disabled', !hasPlans);
          this.subRadio.disabled = !hasPlans;

          if (!this.getSelectedAllocation()) {
            const availableOption = options.find((option) => !option.disabled);
            if (availableOption) this.planSelect.value = availableOption.value;
          }

          if (!this.getSelectedAllocation()) {
            this.oneTimeOption.querySelector('[data-subscription-radio]').checked = true;
          }
        }

        rememberPrice() {
          const priceContainer = this.getPriceContainer();
          if (!priceContainer) return;

          this.priceContainer = priceContainer;
          this.pristinePriceHtml = priceContainer.innerHTML;
          this.pristineClassName = priceContainer.querySelector('.price')?.className || 'price';
        }

        // Pinta el precio del pack en el bloque de precio de DAWN CUANDO ESTÁ EN MODO ONE-TIME
        paintOneTime(formattedPrice) {
          const priceContainer = this.getPriceContainer();
          if (!priceContainer || this.pristinePriceHtml == null) return;

          // applyPrice() reescribió el marcado por completo, así que siempre se parte de la
          // instantánea de Dawn antes de volver a escribir encima.
          priceContainer.innerHTML = this.pristinePriceHtml;

          const priceEl = priceContainer.querySelector('.price');
          if (!priceEl) return;

          // price.liquid usa volume-pricing--sale-badge o price--sold-out en lugar de
          // price--on-sale, y en esos casos ese marcado es el dueño del precio.
          const ownsPrice =
            !priceEl.classList.contains('volume-pricing--sale-badge') &&
            !priceEl.classList.contains('price--sold-out');

          // price.liquid dibuja la misma clase en .price__regular y en .price__sale, así que cada
          // nodo se busca dentro de su contenedor: con price--on-sale visible es .price__sale el
          // que se muestra, y sin él lo es .price__regular.
          const saleRegular = priceEl.querySelector('.price__sale s.price-item--regular');
          const saleItem = priceEl.querySelector('.price__sale .price-item--sale');
          const plainItem = priceEl.querySelector('.price__regular .price-item--regular');

          if (plainItem) plainItem.textContent = formattedPrice;
          if (saleItem) saleItem.textContent = formattedPrice;

          // El total del pack sólo se muestra como oferta cuando hay un precio sin descontar que
          // tachar. Con una cantidad escrita que no casa con ningún pack, o con un pack sin
          // descuento, el marcado se deja tal como Dawn lo renderizó.
          if (!ownsPrice || !this.currentFormattedCompare) {
            priceEl.className = this.pristineClassName || 'price';
            return;
          }

          priceEl.className = this.withPriceClasses(['price--on-sale']);

          if (saleRegular) saleRegular.textContent = this.currentFormattedCompare;
        }

        /**
         * Reinicia las clases de precio a las que Dawn renderizó y añade las de este bloque, para
         * que cambiar entre pack y suscripción no deje `price--on-sale` o `price--subscription`
         * pegadas de un estado al otro.
         */
        withPriceClasses(classes) {
          return (this.pristineClassName || 'price')
            .split(/\s+/)
            .filter(
              (name) =>
                name && name !== 'price--on-sale' && name !== 'price--subscription'
            )
            .concat(classes)
            .join(' ');
        }

        // MONTA LA ESTRUCTURA DE OFERTA/SUSCRIPCIÓN EN EL PRECIO GENERAL DE DAWN
        applyPrice(formattedPrice, compareAtPrice) {
          const priceContainer = this.getPriceContainer();
          if (!priceContainer || this.pristinePriceHtml == null) return;

          const className = this.withPriceClasses(['price--on-sale', 'price--subscription']);

          priceContainer.innerHTML = `
            <div class="${className}">
              <div class="price__container">
                <div class="price__sale">
                  <span class="visually-hidden visually-hidden--inline" data-label="regular"></span>
                  <span><s class="price-item price-item--regular"></s></span>
                  <span class="visually-hidden visually-hidden--inline" data-label="sale"></span>
                  <span class="price-item price-item--sale price-item--last"></span>
                </div>
              </div>
            </div>`;

          const price = priceContainer.querySelector('.price');
          price.querySelector('[data-label="regular"]').textContent = this.dataset.labelRegular || '';
          price.querySelector('[data-label="sale"]').textContent = this.dataset.labelSale || '';
          price.querySelector('.price-item--regular').textContent = compareAtPrice;
          price.querySelector('.price-item--sale').textContent = formattedPrice;
        }

        /**
         * Formatea siguiendo el formato de moneda de la tienda en lugar de asumir dólares con
         * separador de millar: los importes que salen de aquí se comparan con los que escribe
         * Liquid en el mismo producto y tienen que verse igual.
         *
         * Cada clave del formato lleva sus propios separadores porque así es como Liquid las
         * resuelve; `amount` usa los delimitadores por defecto de la tienda, coma y punto.
         */
        formatMoney(cents) {
          const rate = Number(window.Shopify?.currency?.rate) || 1;
          const value = Math.round(cents * rate);
          const template =
            (this.dataset.useCurrency === 'true'
              ? this.dataset.moneyWithCurrencyFormat
              : this.dataset.moneyFormat) || '{{amount}}';

          const negative = value < 0;
          const [whole, decimals] = (Math.abs(value) / 100).toFixed(2).split('.');

          const withSeparator = (separator) => (digits, fraction) =>
            digits.replace(/\B(?=(\d{3})+(?!\d))/g, separator) +
            (fraction ? `.${fraction}` : '');
          const comma = withSeparator(',');
          const apostrophe = withSeparator("'");
          const space = withSeparator(' ');

          const parts = {
            amount: comma(whole, decimals),
            amount_no_decimals: comma(whole),
            amount_with_comma_separator: comma(whole, decimals),
            amount_no_decimals_with_comma_separator: comma(whole),
            amount_with_apostrophe_separator: apostrophe(whole, decimals),
            amount_no_decimals_with_apostrophe_separator: apostrophe(whole),
            amount_with_space_separator: space(whole, decimals),
            amount_no_decimals_with_space_separator: space(whole),
            currency_code: window.Shopify?.currency?.active || ''
          };

          const formatted = template.replace(
            /\{\{\s*(\w+)\s*\}\}/g,
            (match, key) => (key in parts ? parts[key] : '')
          );

          return `${negative ? '-' : ''}${formatted.trim()}`;
        }

        update() {
          const variant = this.getVariant();
          if (!variant) return;

          const planAllocation = this.getSelectedAllocation();
          const isSubscription = this.subRadio.checked && !this.subRadio.disabled && !!planAllocation;

          this.oneTimeOption.classList.toggle('is-active', !isSubscription);
          this.subOption.classList.toggle('is-active', isSubscription);

          this.setScheme(this.oneTimeOption, !isSubscription);
          this.setScheme(this.subOption, isSubscription);

          const quantity = Math.max(1, parseInt(this.currentQty, 10) || 1);

          // CALCULAR PRECIO BASE DE ONE-TIME CON RESPECTO AL PACK O CANTIDAD
          // El total del pack sólo existe en el bloque de packs: un descuento fijo sobre el pack
          // no se puede volver a deducir desde un porcentaje, así que sin él el precio mostrado
          // se iba al precio de variante por la cantidad, sin descuento.
          const oneTimeTotalCents =
            this.overridePriceCents != null ? this.overridePriceCents : variant.price * quantity;

          const formattedOneTime =
            this.currentFormattedPrice || this.formatMoney(oneTimeTotalCents);

          this.oneTimePrice.textContent = formattedOneTime;

          // CALCULAR PRECIO DE SUSCRIPCIÓN CON EL DESCUENTO CORRESPONDIENTE
          if (planAllocation) {
            // El precio de la asignación del plan es el precio de UNA unidad ya descontada, así
            // que el total del pack es ese precio por la cantidad: exactamente lo que se cobra
            // por entrega. Aplicar el porcentaje del plan sobre el total del pack lo descontaría
            // dos veces y además lo haría mal en los packs de descuento fijo.
            const subTotalCents = Math.round((planAllocation.price ?? variant.price) * quantity);

            const formattedSubPrice = this.formatMoney(subTotalCents);
            this.subPrice.textContent = formattedSubPrice;

            this.updateBadge(planAllocation);
            this.updatePerDeliveryPrice(planAllocation, quantity);

            if (isSubscription) {
              this.applyPrice(formattedSubPrice, formattedOneTime);
            }
          } else {
            this.subPrice.textContent = formattedOneTime;
            if (this.badge) this.badge.hidden = true;
          }

          if (isSubscription) {
            this.hiddenInput.value = this.planSelect.value;
          } else {
            this.hiddenInput.value = '';
            // RESTAURA EL PRECIO GENERAL CON EL PRECIO DEL PACK EN MODO ONE-TIME
            this.paintOneTime(formattedOneTime);
          }
        }

        setScheme(option, isSelected) {
          const { schemeActive, schemeInactive } = option.dataset;

          option.classList.toggle(schemeActive, isSelected);
          option.classList.toggle(schemeInactive, !isSelected);
        }

        updateBadge(allocation) {
          if (!this.badge) return;

          if (allocation.discount_percent > 0) {
            this.badge.textContent = this.badge.dataset.template.replace(
              '[percent]',
              allocation.discount_percent
            );
            this.badge.hidden = false;
          } else {
            this.badge.hidden = true;
          }
        }

        updatePerDeliveryPrice(allocation, quantity = 1) {
          if (!this.perDeliveryPrice) return;

          if (!allocation.per_delivery_price_cents && !allocation.formatted_per_delivery_price) {
            this.perDeliveryPrice.hidden = true;
            return;
          }

          // Igual que el total: la entrega lleva el pack entero, no una unidad suelta.
          const price = allocation.per_delivery_price_cents
            ? this.formatMoney(Math.round(allocation.per_delivery_price_cents * quantity))
            : allocation.formatted_per_delivery_price;

          this.perDeliveryPrice.textContent = this.perDeliveryPrice.dataset.template.replace(
            '[price]',
            price
          );
          this.perDeliveryPrice.hidden = false;
        }
      }
    );
  }
</script>
  </product-subscription>
{%- endif -%}
