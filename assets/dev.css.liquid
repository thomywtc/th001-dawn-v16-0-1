/* ====================================== SUSCRIPTION BOX ====================================== */
.shopify_subscriptions_app_container fieldset.shopify_subscriptions_fieldset .shopify_subscriptions_app_block_label{
  border:none!important;
  padding: 0;
  margin: 0;
}
.shopify_subscriptions_app_block_label .shopify_subscriptions_app_block_label_children{
  padding:0;
  display: flex;
  flex-wrap: wrap;
  gap: 25px;
}
.shopify_subscriptions_app_block_label .shopify_subscriptions_app_block_label_children li{
